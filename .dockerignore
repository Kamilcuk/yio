# Exclude everything by default
**

# Allow essential project structure
!src/**
!test/**
!cmake/**
!examples/**
!benchmark/**
!kcmakelib/**
!m4/**
!scripts/**
!extensions/**
!godbolt/**

# Selective third_party inclusion
third_party/**
!third_party/CMakeLists.txt
!third_party/tiny-regex-c/**
!third_party/ryu/**
third_party/ryu/third_party/**
!third_party/libdfp/**

# Allow root configuration files
!CMakeLists.txt
!CMakePresets.json
!Makefile
!GEMINI.md
!LICENSE
!README.md

# Allow specific configuration files
!.clang-tidy
!.cmake-format.py
!.exrc
!cppcheck.cfg
!CPPLINT.cfg
!doc/Doxyfile

# Exclude build artifacts and caches even if they are in allowed directories
**/build/**
**/_build/**
**/.cache/**
**/.git/**
**/.ruff_cache/**
**/Testing/**
**/__pycache__/**
**/*.pyc
**/*.o
**/*.a
**/*.so
**/*.dep
**/compile_commands.json
**/local_makefile.mk

# Third-party specific build artifacts
third_party/libdfp/config.log
third_party/libdfp/config.status
